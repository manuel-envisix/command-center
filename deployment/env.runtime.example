# Auf dem VPS als ~/hosting/command-center/.env.runtime (nicht committen).
# Werte immer in einfachen Anführungszeichen — Passwörter können $ und \ enthalten.
# Keine ${VAR}-Interpolation in docker-compose für Secrets.

COMMAND_CENTER_IMAGE='ghcr.io/manuel-envisix/command-center:latest'
CC_LOGIN_PASSWORD='change-me'
SESSION_SECRET='generate-once-on-vps'
RELAY_SECRET='generate-once-on-vps'
CC_GITHUB_TOKEN=''
CURSOR_API_KEY=''
CC_GITHUB_ORG='manuel-envisix'
GROK_BOT_AGENTS_PATH=''
